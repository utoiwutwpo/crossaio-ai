# CrossBot AI 环境变量模板 — 复制为 .env 后填写（.env 已被 .gitignore 排除）
# ⚠️ 上线前必须处理：JWT_SECRET / ADMIN_TOKEN 改成强随机值；CORS_ORIGINS 锁定具体域名。

# ===== AI（智谱 GLM-4，OpenAI 兼容）=====
# 为空 = Mock 模式；填入后即切换真实生成（含波兰语/罗马尼亚语本地化）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus

# ===== 数据库（生产换 Supabase PostgreSQL）=====
# 本地默认 SQLite；生产示例：
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/crossbot
DATABASE_URL=sqlite:///./crossbot.db

# ===== 认证（⚠️ 上线前必改）=====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# ===== Google 登录（可选）=====
# Google Cloud Console → API和服务 → 凭据 → OAuth 客户端 ID（Web）
# 已授权重定向 URI 填 {APP_URL}/users/google（如 http://localhost:9000/users/google）
# 已授权 JS 来源填站点地址（GIS 弹窗备用），如 http://localhost:9000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 出网代理（可选）=====
# 中国大陆直连 Google 等海外 API 会被阻断：填本地代理如 http://127.0.0.1:7890（Clash 等）；海外服务器部署留空
PROXY_URL=

# ===== 管理端点（埋点漏斗 /api/v1/analytics/summary 请求头 X-Admin-Token）=====
ADMIN_TOKEN=

# ===== Stripe（上线收款时填，必填才能真实收费）=====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ===== PayPal（可选第二支付通道）=====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox          # 上线改 live
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_BUSINESS=

# ===== eBay 接入 =====
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENCRYPTION_KEY=        # base64 AES-256 密钥；留空则用 dev key

# ===== Listing 监控定时体检 =====
WATCH_SCHEDULER_ENABLED=true
WATCH_DAILY_HOUR=8

# ===== SMTP 日报（不配置则只入库不发邮件）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== 应用 =====
APP_NAME=CrossBot AI
APP_URL=http://localhost:8000      # ⚠️ 改成你的真实域名
CORS_ORIGINS=*                     # ⚠️ 生产必须锁具体域名，不要用 *

# ===== SEO（Google 收录）=====
# SEO 身份域名（sitemap.xml / robots.txt / canonical / hreflang 用）
# 留空则默认 https://www.crossaio.com；本机调试无需修改
SITE_PUBLIC_URL=
# Google Search Console 所有权验证文件名：在 GSC 添加资源时选「HTML 文件」方式，
# 把下载的文件名（如 google5c1a2b3d4e5f6789.html）填到这里，
# 访问 https://你的域名/google****.html 返回 200 即可通过验证
GOOGLE_SITE_VERIFICATION=
